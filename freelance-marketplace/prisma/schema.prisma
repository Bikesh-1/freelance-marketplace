generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String  @id @default(cuid())
  name          String
  email         String  @unique
  password      String
  role          Role
  walletAddress String? @unique
  isVerified    Boolean @default(false)

  sentMessages      Message[]          @relation("SentMessages")
  receivedMessages  Message[]          @relation("ReceivedMessages")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  clientProfile     ClientProfile?
  freelancerProfile FreelancerProfile?

  notifications      Notification[]
  walletTransactions WalletTransaction[]
  recommendations    AIRecommendation[]
  openedDisputes     Dispute[]

  @@index([role])
  @@index([walletAddress])
}

model FreelancerProfile {
  id                 String            @id @default(cuid())
  userId             String            @unique
  title              String
  bio                String
  fullName           String?
  country            String?
  walletBalance      Float             @default(0)
  isProfileCompleted Boolean           @default(false)
  experienceLevel    ExperienceLevel
  hourlyRate         Float
  location           String?
  github             String?
  linkedin           String?
  portfolio          String?
  yearsOfExperience  Int               @default(0)
  totalProjects      Int               @default(0)
  averageRating      Float             @default(0)
  aiEmbedding        String?
  isAvailable        Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills             FreelancerSkill[]
  portfolios         Portfolio[]
  applications       Application[]
  reviews            Review[]
  experiences        Experience[]
  selectedJobs       Job[]

  @@index([hourlyRate])
  @@index([experienceLevel])
  @@index([averageRating])
  @@index([isAvailable])
}

model ClientProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  companyName        String
  companyBio         String
  website            String?
  country            String?
  isProfileCompleted Boolean  @default(false)
  totalJobsPosted    Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs               Job[]
  reviews            Review[]
}

model Skill {
  id          String            @id @default(cuid())
  name        String            @unique
  createdAt   DateTime          @default(now())
  freelancers FreelancerSkill[]
  jobSkills   JobSkill[]
}

model FreelancerSkill {
  freelancerId String
  skillId      String
  freelancer   FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  skill        Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([freelancerId, skillId])
}

model Job {
  id                   String      @id @default(cuid())
  clientId             String
  title                String
  description          String      @db.Text
  budget               Float
  jobType              JobType
  duration             String?
  requiredSkills       String[]
  milestones           Milestone[]
  messages             Message[]
  status               JobStatus   @default(OPEN)
  deadline             DateTime
  selectedFreelancerId String?
  aiEmbedding          String?

  client ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  selectedFreelancer FreelancerProfile? @relation(fields: [selectedFreelancerId], references: [id], onDelete: SetNull)

  applications Application[]
  escrow       Escrow[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  skills       JobSkill[]

  @@index([status])
  @@index([budget])
  @@index([deadline])
  @@index([selectedFreelancerId])
}

model Portfolio {
  id           String            @id @default(cuid())
  freelancerId String
  title        String
  description  String            @db.Text
  projectUrl   String?
  githubUrl    String?
  imageUrl     String?
  liveUrl      String?
  freelancer   FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())
}

model Application {
  id String @id @default(cuid())

  jobId        String
  freelancerId String

  coverLetter    String @db.Text
  proposedBudget Float

  aiScore    Float?
  status     ApplicationStatus @default(PENDING)
  job        Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  freelancer FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([jobId, freelancerId])
  @@index([status])
  @@index([aiScore])
}

model Review {
  id           String @id @default(cuid())
  clientId     String
  freelancerId String

  rating Int

  isVisible  Boolean   @default(true)
  isVerified Boolean   @default(false)
  reply      String?
  repliedAt  DateTime?

  comment    String            @db.Text
  client     ClientProfile     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  freelancer FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())

  @@index([rating])
  @@index([isVisible])
}

model Message {
  id         String  @id @default(cuid())
  jobId      String
  senderId   String
  receiverId String
  content    String  @db.Text
  isRead     Boolean @default(false)

  readAt DateTime?

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  sender User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([jobId])
  @@index([senderId])
  @@index([receiverId])
}

model Escrow {
  id              String       @id @default(cuid())
  jobId           String
  contractAddress String
  transactionHash String?
  milestone       Milestone?
  network         String       @default("sepolia")
  amount          Float
  status          EscrowStatus @default(CREATED)

  blockchainEscrowId Int?

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([network])
}

model Transaction {
  id String @id @default(cuid())

  escrowId String?
  escrow   Escrow? @relation(fields: [escrowId], references: [id], onDelete: Cascade)

  txHash String
  amount Float

  fromAddress String
  toAddress   String

  blockNumber Int?

  status TransactionStatus @default(PENDING)

  gasUsed String?

  network String @default("sepolia")

  createdAt DateTime @default(now())

  @@index([txHash])
  @@index([network])
}

model Notification {
  id String @id @default(cuid())

  userId  String
  type    NotificationType
  title   String
  message String           @db.Text
  isRead  Boolean          @default(false)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model Milestone {
  id String @id @default(cuid())

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  title       String
  description String?

  amount Float

  dueDate DateTime?

  status MilestoneStatus @default(PENDING)

  submissionNote String?   @db.Text
  submissionUrl  String?
  submittedAt    DateTime?

  disputes Dispute[]

  escrowId String? @unique
  escrow   Escrow? @relation(fields: [escrowId], references: [id])

  order Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([status])
}

model AIRecommendation {
  id           String   @id @default(cuid())
  userId       String
  jobId        String?
  freelancerId String?
  score        Float
  reason       String   @db.Text
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([score])
}

model WalletTransaction {
  id            String   @id @default(cuid())
  userId        String
  txHash        String   @unique
  amount        Float
  type          String
  network       String
  walletAddress String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([txHash])
}

model BlockchainEvent {
  id          String   @id @default(cuid())
  escrowId    String?
  eventName   String
  txHash      String
  blockNumber Int
  network     String
  payload     String   @db.Text
  createdAt   DateTime @default(now())

  @@index([txHash])
  @@index([eventName])
}

model Experience {
  id String @id @default(cuid())

  companyName String
  role        String
  description String @db.Text

  startDate DateTime
  endDate   DateTime?

  createdAt DateTime @default(now())

  freelancerId String
  freelancer   FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
}

model JobSkill {
  id String @id @default(cuid())

  jobId   String
  skillId String

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
}

model Dispute {
  id String @id @default(cuid())

  milestoneId String
  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  openedById String
  openedBy User @relation(fields: [openedById], references: [id], onDelete: Cascade)

  reason String
  evidence String?

  status DisputeStatus @default(OPEN)

  adminNotes String?

  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([milestoneId])
  @@index([status])
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum MilestoneStatus {
  PENDING
  FUNDED
  SUBMITTED
  DISPUTED
  APPROVED
  RELEASED
  REFUNDED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum Role {
  CLIENT
  FREELANCER
  ADMIN
}

enum JobType {
  FIXED
  HOURLY
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum JobStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EscrowStatus {
  CREATED
  FUNDED
  RELEASED
  REFUNDED
}

enum NotificationType {
  JOB_POSTED
  APPLICATION_RECEIVED
  APPLICATION_ACCEPTED
  APPLICATION_REJECTED
  PAYMENT_FUNDED
  PAYMENT_RELEASED
  PAYMENT_REFUNDED
  MESSAGE_RECEIVED
  SYSTEM
}
